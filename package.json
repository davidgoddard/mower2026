{
  "name": "mower",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous mower control runtime",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "test": "node --test test/*.test.js",
    "verify:mowing-angles": "node scripts/verify-mowing-plan-angles.mjs",
    "start": "./scripts/mower-launch.sh",
    "test:controller": "node ./external-hardware/manual-tests/controller_inspector.js",
    "lint": "npm run typecheck",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "i2c-bus": "^5.2.3",
    "node-hid": "^3.1.2"
  }
}

{
  "name": "mower",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous mower control runtime",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "test": "node --test test",
    "start": "./scripts/mower-launch.sh",
    "lint": "npm run typecheck",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "i2c-bus": "^5.2.3"
  }
}
